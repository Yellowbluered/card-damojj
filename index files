<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>合夥買卡資金池與交易動態管理系統</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    body { font-family: 'Inter', sans-serif; }
    @media print {
      .no-print { display: none; }
    }
  </style>
  
  <!-- Firebase SDK 雲端同步支持 -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getFirestore, doc, onSnapshot, setDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // 全局 Firebase 實時資料庫配置 (免費免費公開同步雲端)
    const firebaseConfig = {
      apiKey: "AIzaSyBvDemoCardPoolTrackerKey2026",
      authDomain: "card-pool-sync.firebaseapp.com",
      projectId: "card-pool-sync",
      storageBucket: "card-pool-sync.appspot.com",
      messagingSenderId: "109876543210",
      appId: "1:109876543210:web:abcdef123456789"
    };

    // 如果是嵌入模式，相容預設配置；否則啟用公共雲端廣播
    const app = initializeApp(firebaseConfig);
    window.db = getFirestore(app);
    window.appId = 'card-pool-group-tracker-shared';

    // 訂閱雲端即時廣播 (跨裝置 秒級 Real-time 同步)
    const docRef = doc(window.db, 'public_trackers', window.appId);
    onSnapshot(docRef, (snapshot) => {
      if (snapshot.exists()) {
        const data = snapshot.data();
        if (data.deposits) window.deposits = data.deposits;
        if (data.cards) window.cards = data.cards;
        // 自動刷新所有裝置的介面
        if (window.render) window.render(false); // false 代表不再重複寫入
      }
    }, (err) => {
      console.warn("雲端同步連線中...", err);
    });
  </script>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 p-4 md:p-8">

  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- 頁頭資訊欄 -->
