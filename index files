  <!-- 高清大圖預覽 Modal -->
  <div id="image-modal" class="fixed inset-0 bg-slate-900/80 flex items-center justify-center p-4 z-50 hidden" onclick="closeImageModal()">
    <div class="relative max-w-2xl w-full flex flex-col items-center">
      <img id="modal-img-display" src="#" class="max-h-[80vh] max-w-full rounded-lg shadow-2xl object-contain">
      <p id="modal-img-caption" class="text-white text-sm font-medium mt-3 bg-slate-800/80 px-4 py-1.5 rounded-full"></p>
    </div>
  </div>

  <!-- JavaScript 邏輯與數據綁定 -->
  <script>
    // 預設 6 人成員名單
    const members = ["Marco", "Olivio", "Alden", "Dulio", "Jeff", "Justin"];
    
    // 初始化 State
    let deposits = JSON.parse(localStorage.getItem("card_pool_deposits")) || [
      { id: 1, month: "2026-01 (1號)", member: "Marco", amount: 1000 },
      { id: 2, month: "2026-01 (1號)", member: "Olivio", amount: 1000 },
      { id: 3, month: "2026-01 (1號)", member: "Alden", amount: 1000 },
      { id: 4, month: "2026-01 (1號)", member: "Dulio", amount: 1000 },
      { id: 5, month: "2026-01 (1號)", member: "Jeff", amount: 1000 },
      { id: 6, month: "2026-01 (1號)", member: "Justin", amount: 1000 }
    ];

    let cards = JSON.parse(localStorage.getItem("card_pool_cards")) || [
      {
        id: 101,
        buyDate: "2026-01-05",
        name: "2023 Chrome Bellingham Auto /49",
        imageData: null,
        costPrice: 4500,
        fee: 50,
        totalCost: 4550,
        note: "Marco 獨力決定 (≤12,000元)",
        status: "ACTIVE", // ACTIVE 或 SOLD
        sellDate: null,
        sellPrice: null,
        sellFee: null,
        netReturn: null,
        profit: null
      }
    ];

    let currentImageBase64 = null;

    // 設定預設日期
    document.getElementById("dep-month").value = "2026-01";
    document.getElementById("buy-date").valueAsDate = new Date();

    // 圖片轉成 Base64 縮圖儲存
    function previewCardImage(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement("canvas");
          const MAX_WIDTH = 600;
          let width = img.width;
          let height = img.height;

          if (width > MAX_WIDTH) {
            height = Math.round((height * MAX_WIDTH) / width);
            width = MAX_WIDTH;
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, width, height);

          currentImageBase64 = canvas.toDataURL("image/jpeg", 0.7);
          document.getElementById("image-preview").src = currentImageBase64;
          document.getElementById("image-preview-container").classList.remove("hidden");
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function openImageModal(imgSrc, caption) {
      document.getElementById("modal-img-display").src = imgSrc;
      document.getElementById("modal-img-caption").innerText = caption;
      document.getElementById("image-modal").classList.remove("hidden");
    }

    function closeImageModal() {
      document.getElementById("image-modal").classList.add("hidden");
    }

    // 保存至本地
    function saveState() {
      localStorage.setItem("card_pool_deposits", JSON.stringify(deposits));
      localStorage.setItem("card_pool_cards", JSON.stringify(cards));
    }

    // 切換表單頁籤
    function switchTab(tab) {
      if (tab === 'deposit') {
        document.getElementById("form-deposit").classList.remove("hidden");
        document.getElementById("form-card").classList.add("hidden");
        document.getElementById("tab-btn-deposit").className = "pb-3 px-4 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600";
        document.getElementById("tab-btn-card").className = "pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700";
      } else {
        document.getElementById("form-card").classList.remove("hidden");
        document.getElementById("form-deposit").classList.add("hidden");
        document.getElementById("tab-btn-card").className = "pb-3 px-4 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600";
        document.getElementById("tab-btn-deposit").className = "pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700";
      }
    }

    // 核心計算與渲染函數
    window.render = function() {
      saveState();

      // 1. 計算全隊總出資與個人出資
      let totalDeposit = 0;
      const memberDeposits = {};
      members.forEach(m => memberDeposits[m] = 0);

      deposits.forEach(d => {
        totalDeposit += Number(d.amount);
        if (memberDeposits[d.member] !== undefined) {
          memberDeposits[d.member] += Number(d.amount);
        } else {
          memberDeposits[d.member] = Number(d.amount);
        }
      });

      // 2. 計算卡牌財務 (持卡成本、已賣出回款與盈虧)
      let activeCardCost = 0;
      let activeCardsCount = 0;
      let totalSellNetReturn = 0;
      let totalProfit = 0;
      let soldCardsCount = 0;

      cards.forEach(c => {
        if (c.status === "ACTIVE") {
          activeCardCost += Number(c.totalCost);
          activeCardsCount++;
        } else if (c.status === "SOLD") {
          totalSellNetReturn += Number(c.netReturn);
          totalProfit += Number(c.profit);
          soldCardsCount++;
        }
      });

      // 即時現金餘額 = 歷史總入金 - 持卡總成本 + 已賣出卡牌淨回款
      const cashBalance = totalDeposit - activeCardCost + totalSellNetReturn;

      // 3. 渲染頂部卡片
      document.getElementById("stat-cash").innerText = `¥ ${cashBalance.toLocaleString('zh-CN', {minimumFractionDigits: 2})}`;
      document.getElementById("stat-card-cost").innerText = `¥ ${activeCardCost.toLocaleString('zh-CN', {minimumFractionDigits: 2})}`;
      document.getElementById("stat-active-cards-count").innerText = `持有中: ${activeCardsCount} 張卡`;
      document.getElementById("stat-total-deposit").innerText = `¥ ${totalDeposit.toLocaleString('zh-CN', {minimumFractionDigits: 2})}`;
      
      const profitEl = document.getElementById("stat-profit");
      profitEl.innerText = `${totalProfit >= 0 ? '+' : ''}¥ ${totalProfit.toLocaleString('zh-CN', {minimumFractionDigits: 2})}`;
      profitEl.className = `text-2xl font-bold mt-2 ${totalProfit >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;

      const roi = totalDeposit > 0 ? (totalProfit / totalDeposit) * 100 : 0;
      document.getElementById("stat-roi").innerText = `總投資回報率 (ROI): ${roi.toFixed(2)}%`;

      // 4. 渲染成員動態份額 (%) 表格
      document.getElementById("share-total-deposit").innerText = `¥ ${totalDeposit.toLocaleString('zh-CN')}`;
      const shareTable = document.getElementById("member-share-table");
      shareTable.innerHTML = members.map(m => {
        const userDep = memberDeposits[m] || 0;
        const sharePct = totalDeposit > 0 ? ((userDep / totalDeposit) * 100).toFixed(2) : "0.00";
        return `
          <tr class="hover:bg-slate-50">
            <td class="py-2.5 pl-2 font-medium text-slate-800">${m}</td>
            <td class="py-2.5 text-right font-medium">¥ ${userDep.toLocaleString('zh-CN')}</td>
            <td class="py-2.5 text-right font-bold text-indigo-600">${sharePct}%</td>
          </tr>
        `;
      }).join('');

      // 5. 渲染卡牌列表
      document.getElementById("cards-tab-count").innerText = `持卡: ${activeCardsCount}`;
      document.getElementById("sold-tab-count").innerText = `已賣出: ${soldCardsCount}`;

      const cardTable = document.getElementById("card-list-table");
      if (cards.length === 0) {
        cardTable.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400 text-xs">目前暫無卡牌紀錄</td></tr>`;
      } else {
        cardTable.innerHTML = cards.map(c => {
          const isSold = c.status === "SOLD";
          const imgHtml = c.imageData 
            ? `<img src="${c.imageData}" onclick="openImageModal('${c.imageData}', '${c.name}')" class="w-12 h-12 object-cover rounded-lg border border-slate-200 cursor-pointer hover:opacity-80 transition-opacity shadow-2xs flex-shrink-0">` 
            : `<div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-lg flex items-center justify-center text-xs flex-shrink-0 border border-slate-200">無相片</div>`;

          return `
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-3 pl-4">
                <div class="flex items-center gap-3">
                  ${imgHtml}
                  <div>
                    <div class="font-medium text-slate-900">${c.name}</div>
                    <div class="text-xs text-slate-400">買入日: ${c.buyDate} • <span class="text-indigo-600">${c.note}</span></div>
                  </div>
                </div>
              </td>
              <td class="p-3 text-right font-medium">¥ ${Number(c.totalCost).toLocaleString('zh-CN')}</td>
              <td class="p-3 text-center">
                ${isSold 
                  ? `<span class="px-2 py-0.5 text-xs font-semibold rounded bg-emerald-100 text-emerald-800">已平倉賣出</span>`
                  : `<span class="px-2 py-0.5 text-xs font-semibold rounded bg-blue-100 text-blue-800">持有中</span>`}
              </td>
              <td class="p-3 text-right font-medium text-slate-700">
                ${isSold ? `¥ ${Number(c.netReturn).toLocaleString('zh-CN')}` : '-'}
              </td>
              <td class="p-3 text-right font-bold">
                ${isSold 
                  ? (c.profit >= 0 
                      ? `<span class="text-emerald-600">+¥ ${Number(c.profit).toLocaleString('zh-CN')}</span>` 
                      : `<span class="text-rose-600">-¥ ${Math.abs(c.profit).toLocaleString('zh-CN')}</span>`)
                  : '-'}
              </td>
              <td class="p-3 text-center pr-4 no-print">
                <div class="flex items-center justify-center gap-1.5">
                  ${!isSold 
                    ? `<button onclick="openSellModal(${c.id})" class="px-2.5 py-1 text-xs bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded transition-colors">平倉賣出</button>
                       <button onclick="deleteCard(${c.id})" class="px-2 py-1 text-xs text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded transition-colors" title="刪除紀錄">剷除</button>`
                    : `<button onclick="deleteCard(${c.id})" class="px-2 py-1 text-xs text-slate-400 hover:text-rose-600">刪除</button>`}
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      // 6. 渲染歷史入金紀錄
      const depositTable = document.getElementById("deposit-list-table");
      if (deposits.length === 0) {
        depositTable.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-slate-400 text-xs">目前暫無入金紀錄</td></tr>`;
      } else {
        depositTable.innerHTML = deposits.slice().reverse().map(d => `
          <tr class="hover:bg-slate-50">
            <td class="p-3 pl-4 font-medium text-slate-900">${d.month}</td>
            <td class="p-3 font-medium text-slate-700">${d.member}</td>
            <td class="p-3 text-right font-semibold text-emerald-600">¥ ${Number(d.amount).toLocaleString('zh-CN')}</td>
            <td class="p-3 text-center pr-4 no-print">
              <button onclick="deleteDeposit(${d.id})" class="text-xs text-rose-500 hover:text-rose-700 hover:underline">刪除</button>
            </td>
          </tr>
        `).join('');
      }
    };

    // 同步儲存至雲端
    async function saveStateToCloud() {
      if (window.db) {
        try {
          const { doc, setDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
          const docRef = doc(window.db, 'artifacts', window.appId, 'public', 'data', 'tracker_state', 'main');
          await setDoc(docRef, { deposits, cards }, { merge: true });
        } catch (e) {
          console.error("雲端同步發送失敗:", e);
        }
      }
    }

    // 提交入金
    function addDeposit(e) {
      e.preventDefault();
      const monthInput = document.getElementById("dep-month").value;
      const amount = Number(document.getElementById("dep-amount").value);
      const checkedMembers = Array.from(document.querySelectorAll('input[name="dep-members"]:checked')).map(cb => cb.value);

      if (checkedMembers.length === 0) {
        alert("請至少選擇一位繳費成員！");
        return;
      }

      checkedMembers.forEach(m => {
        deposits.push({
          id: Date.now() + Math.random(),
          month: `${monthInput} (1號)`,
          member: m,
          amount: amount
        });
      });

      saveStateToCloud();
      render();
    }

    // 刪除入金紀錄
    function deleteDeposit(id) {
      deposits = deposits.filter(d => d.id !== id);
      saveStateToCloud();
      render();
    }

    // 提交買卡
    function addCardBuy(e) {
      e.preventDefault();
      const buyDate = document.getElementById("buy-date").value;
      const name = document.getElementById("buy-name").value;
      const price = Number(document.getElementById("buy-price").value);
      const fee = Number(document.getElementById("buy-fee").value);
      const note = document.getElementById("buy-note").value;

      const totalCost = price + fee;

      cards.push({
        id: Date.now(),
        buyDate,
        name,
        imageData: currentImageBase64,
        costPrice: price,
        fee,
        totalCost,
        note,
        status: "ACTIVE",
        sellDate: null,
        sellPrice: null,
        sellFee: null,
        netReturn: null,
        profit: null
      });

      // 重設表單
      document.getElementById("buy-name").value = "";
      document.getElementById("buy-price").value = "";
      document.getElementById("buy-fee").value = "0";
      document.getElementById("buy-image").value = "";
      document.getElementById("image-preview-container").classList.add("hidden");
      currentImageBase64 = null;

      saveStateToCloud();
      render();
    }

    // 打開賣出彈窗
    function openSellModal(id) {
      const card = cards.find(c => c.id === id);
      if (!card) return;

      document.getElementById("sell-card-id").value = card.id;
      document.getElementById("sell-card-name-display").innerText = `${card.name} (總成本: ¥${card.totalCost})`;
      document.getElementById("sell-date").valueAsDate = new Date();
      document.getElementById("sell-modal").classList.remove("hidden");
    }

    function closeSellModal() {
      document.getElementById("sell-modal").classList.add("hidden");
    }

    // 確認賣出
    function confirmSell(e) {
      e.preventDefault();
      const id = Number(document.getElementById("sell-card-id").value);
      const sellDate = document.getElementById("sell-date").value;
      const sellPrice = Number(document.getElementById("sell-price").value);
      const sellFee = Number(document.getElementById("sell-fee").value);

      const netReturn = sellPrice - sellFee;

      const cardIndex = cards.findIndex(c => c.id === id);
      if (cardIndex !== -1) {
        cards[cardIndex].status = "SOLD";
        cards[cardIndex].sellDate = sellDate;
        cards[cardIndex].sellPrice = sellPrice;
        cards[cardIndex].sellFee = sellFee;
        cards[cardIndex].netReturn = netReturn;
        cards[cardIndex].profit = netReturn - cards[cardIndex].totalCost;
      }

      closeSellModal();
      saveStateToCloud();
      render();
    }

    // 刪除卡牌紀錄 (剷除功能)
    function deleteCard(id) {
      cards = cards.filter(c => c.id !== id);
      saveStateToCloud();
      render();
    }

    // 匯出 CSV 檔 (支援 Excel 打開)
    function exportToCSV() {
      let csvContent = "\uFEFF"; // UTF-8 BOM
      csvContent += "類別,日期/月份,名稱/成員,金額/總成本,狀態,淨回款,盈虧,備註\n";

      deposits.forEach(d => {
        csvContent += `會費入金,${d.month},${d.member},${d.amount},已入帳,-,-,-\n`;
      });

      cards.forEach(c => {
        csvContent += `買賣卡牌,${c.buyDate},"${c.name}",${c.totalCost},${c.status === 'SOLD' ? '已賣出' : '持有中'},${c.netReturn || '-'},${c.profit || '-'},"${c.note}"\n`;
      });

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `卡牌合夥資金池帳目表_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    }

    // 頁面加載完成後自動初始化
    window.onload = function() {
      render();
    };
  </script>
</body>
</html>
