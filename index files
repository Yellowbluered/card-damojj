<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>合夥買卡資金池與交易動態管理系統</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    body { font-family: 'Inter', sans-serif; }
    @media print {
      .no-print { display: none; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 p-4 md:p-8">

  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- 頁頭資訊欄 -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">🎴 合夥買卡資金池與交易動態管理系統</h1>
        <div class="flex items-center gap-2 mt-1">
          <span class="inline-block w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></span>
          <p class="text-sm text-slate-500">雲端全自動即時同步中 • 6人動態份額 (%) • 買賣卡明細</p>
        </div>
      </div>
      <div class="flex gap-2 no-print">
        <button onclick="syncFromCloud()" class="flex items-center gap-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-medium px-4 py-2 rounded-lg text-sm transition-colors border border-indigo-200">
          <span>🔄</span> 強制從雲端拉取最新數據
        </button>
        <button onclick="exportToCSV()" class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-4 py-2 rounded-lg text-sm transition-colors shadow-xs">
          <span>📊</span> 匯出 Excel
        </button>
      </div>
    </header>

    <!-- 頂部即時數據統計卡片 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">即時池內現金餘額</div>
        <div id="stat-cash" class="text-2xl font-bold text-emerald-600 mt-2">¥ 0.00</div>
        <div class="text-xs text-slate-400 mt-1">上限 ¥100,000 (可隨時調整)</div>
      </div>

      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">持卡總成本</div>
        <div id="stat-card-cost" class="text-2xl font-bold text-indigo-600 mt-2">¥ 0.00</div>
        <div id="stat-active-cards-count" class="text-xs text-slate-400 mt-1">持有中: 0 張卡</div>
      </div>

      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">已實現總盈虧 (已賣出)</div>
        <div id="stat-profit" class="text-2xl font-bold text-slate-900 mt-2">¥ 0.00</div>
        <div id="stat-roi" class="text-xs text-slate-400 mt-1">總投資回報率 (ROI): 0.00%</div>
      </div>

      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">歷史累計總入金</div>
        <div id="stat-total-deposit" class="text-2xl font-bold text-slate-800 mt-2">¥ 0.00</div>
        <div class="text-xs text-slate-400 mt-1">成員固定 6 人 (每月1號繳費)</div>
      </div>
    </div>

    <!-- 主要功能區：動態份額與表單 -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- 左側：成員動態權益份額 (%) 即時排行榜 -->
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <span>👥</span> 成員即時動態份額 (%)
            </h2>
            <span class="text-xs bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full font-medium">即時動態計算中</span>
          </div>

          <p class="text-xs text-slate-500 mb-4 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
            <strong>公式：</strong> 個人歷史累計入資 ÷ 全隊歷史累計總入資 × 100%<br>
            所有卡牌賣出分紅與清算嚴格按此百分比劃分。
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead class="text-xs text-slate-400 uppercase bg-slate-50 border-b border-slate-100">
                <tr>
                  <th class="pb-2 pt-2 pl-2">成員名稱</th>
                  <th class="pb-2 pt-2 text-right">累計出資</th>
                  <th class="pb-2 pt-2 text-right">權益份額 (%)</th>
                </tr>
              </thead>
              <tbody id="member-share-table" class="divide-y divide-slate-100">
                <!-- 動態生成 -->
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100">
          <div class="text-xs text-slate-400 flex justify-between">
            <span>全隊總出資額</span>
            <span id="share-total-deposit" class="font-bold text-slate-700">¥ 0</span>
          </div>
        </div>
      </div>

      <!-- 中間及右側：輸入表單區 -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- 頁籤按鈕 (入金 vs 買卡) -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <div class="flex border-b border-slate-200 mb-6">
            <button id="tab-btn-deposit" onclick="switchTab('deposit')" class="pb-3 px-4 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600">
              ➕ 登記成員月度入金 (每月1號)
            </button>
            <button id="tab-btn-card" onclick="switchTab('card')" class="pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700">
              🎴 登記買入新卡 (建倉)
            </button>
          </div>

          <!-- 入金登記表單 -->
          <form id="form-deposit" onsubmit="addDeposit(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">選擇月份 (每月1號固定入金)</label>
                <input type="month" id="dep-month" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">每名成員固定出資 (RMB)</label>
                <input type="number" id="dep-amount" value="1000" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-2">勾選本期已成功轉帳繳費之成員：</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-slate-50 p-4 rounded-lg border border-slate-200">
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                  <input type="checkbox" name="dep-members" value="Marco" checked class="w-4 h-4 text-indigo-600 rounded"> Marco
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                  <input type="checkbox" name="dep-members" value="Olivio" checked class="w-4 h-4 text-indigo-600 rounded"> Olivio
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                  <input type="checkbox" name="dep-members" value="Alden" checked class="w-4 h-4 text-indigo-600 rounded"> Alden
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                  <input type="checkbox" name="dep-members" value="Dulio" checked class="w-4 h-4 text-indigo-600 rounded"> Dulio
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                  <input type="checkbox" name="dep-members" value="Jeff" checked class="w-4 h-4 text-indigo-600 rounded"> Jeff
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                  <input type="checkbox" name="dep-members" value="Justin" checked class="w-4 h-4 text-indigo-600 rounded"> Justin
                </label>
              </div>
            </div>

            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg text-sm transition-colors shadow-xs">
              確認提交當月入金紀錄 (即時同步雲端)
            </button>
          </form>

          <!-- 買卡登記表單 (預設隱藏) -->
          <form id="form-card" onsubmit="addCardBuy(event)" class="space-y-4 hidden">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">購買日期</label>
                <input type="date" id="buy-date" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">球員姓名與卡牌詳情 (卡種/編號)</label>
                <input type="text" id="buy-name" placeholder="例: 2023 Chrome Bellingham Auto /49" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">成交金額 (RMB)</label>
                <input type="number" step="0.01" id="buy-price" placeholder="0.00" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">相關費用 (運費/平台手續費 RMB)</label>
                <input type="number" step="0.01" id="buy-fee" value="0" class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">決策授權類別</label>
              <select id="buy-note" class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                <option value="Marco 獨力決定 (≤12,000元)">Marco 獨力決定 (≤12,000元)</option>
                <option value="常規投票過半數同意 (12,001~20,000元)">常規投票過半數同意 (12,001~20,000元)</option>
                <option value="常規投票極大多數同意 (>20,000元)">常規投票極大多數同意 (>20,000元)</option>
                <option value="緊急採購特別條款 (>12,000元 限時≥3人同意)">緊急採購特別條款 (>12,000元 限時≥3人同意)</option>
              </select>
            </div>

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-lg text-sm transition-colors shadow-xs">
              確認扣除資金池現金並買入卡牌 (即時同步雲端)
            </button>
          </form>

        </div>
      </div>
    </div>

    <!-- 下方：卡牌資產與交易明細表 -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>📦</span> 卡牌資產明細與平倉賣出紀錄
          </h2>
        </div>
        <div class="flex gap-2 text-xs font-medium">
          <span id="cards-tab-count" class="px-3 py-1 bg-blue-50 text-blue-700 rounded-md">持卡: 0</span>
          <span id="sold-tab-count" class="px-3 py-1 bg-emerald-50 text-emerald-700 rounded-md">已賣出: 0</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-xs text-slate-400 uppercase bg-slate-50 border-b border-slate-100">
            <tr>
              <th class="p-3 pl-4">卡牌名稱 / 買入日</th>
              <th class="p-3 text-right">總成本 (含費)</th>
              <th class="p-3 text-center">狀態</th>
              <th class="p-3 text-right">賣出淨回款</th>
              <th class="p-3 text-right">單卡盈虧</th>
              <th class="p-3 text-center pr-4">操作 (包含剷除)</th>
            </tr>
          </thead>
          <tbody id="card-list-table" class="divide-y divide-slate-100">
            <!-- 動態生成卡牌紀錄 -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- 歷史入金紀錄流水賬 -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>🧾</span> 歷史入金紀錄流水賬
        </h2>
      </div>
      <div class="overflow-x-auto max-h-64 overflow-y-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-xs text-slate-400 uppercase bg-slate-50 border-b border-slate-100 sticky top-0">
            <tr>
              <th class="p-3 pl-4">月份</th>
              <th class="p-3">繳費成員</th>
              <th class="p-3 text-right">個人出資</th>
              <th class="p-3 text-center pr-4">管理</th>
            </tr>
          </thead>
          <tbody id="deposit-list-table" class="divide-y divide-slate-100">
            <!-- 動態生成入金歷史 -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- 賣出彈窗 Modal -->
  <div id="sell-modal" class="fixed inset-0 bg-slate-900/50 flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white rounded-xl max-w-md w-full p-6 space-y-4 shadow-xl">
      <h3 class="text-lg font-bold text-slate-900">🎴 執行卡牌平倉賣出</h3>
      <p id="sell-card-name-display" class="text-xs text-slate-500 font-medium"></p>
      
      <form onsubmit="confirmSell(event)" class="space-y-4">
        <input type="hidden" id="sell-card-id">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">賣出成交日期</label>
          <input type="date" id="sell-date" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">賣出成交總價 (RMB)</label>
          <input type="number" step="0.01" id="sell-price" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">扣除平台手續費/運費 (RMB)</label>
          <input type="number" step="0.01" id="sell-fee" value="0" class="w-full border border-slate-300 rounded-lg p-2.5 text-sm">
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="closeSellModal()" class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-2 rounded-lg text-sm">取消</button>
          <button type="submit" class="w-1/2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded-lg text-sm">確認賣出並入帳</button>
        </div>
      </form>
    </div>
  </div>

  <!-- JavaScript 雲端自動同步的核心邏輯 -->
  <script>
    const members = ["Marco", "Olivio", "Alden", "Dulio", "Jeff", "Justin"];
    
    // 使用全球極速免費雲端存儲 JSONStorage API (專屬 6 人公共數據庫 ID)
    const CLOUD_STORAGE_URL = "https://api.jsonbin.io/v3/b/65f12345abcd9876543210fe"; // 雲端共享同步端點

    let deposits = [
      { id: 1, month: "2026-01 (1號)", member: "Marco", amount: 1000 },
      { id: 2, month: "2026-01 (1號)", member: "Olivio", amount: 1000 },
      { id: 3, month: "2026-01 (1號)", member: "Alden", amount: 1000 },
      { id: 4, month: "2026-01 (1號)", member: "Dulio", amount: 1000 },
      { id: 5, month: "2026-01 (1號)", member: "Jeff", amount: 1000 },
      { id: 6, month: "2026-01 (1號)", member: "Justin", amount: 1000 }
    ];

    let cards = [
      {
        id: 101,
        buyDate: "2026-01-05",
        name: "2023 Chrome Bellingham Auto /49",
        costPrice: 4500,
        fee: 50,
        totalCost: 4550,
        note: "Marco 獨力決定 (≤12,000元)",
        status: "ACTIVE",
        sellDate: null,
        sellPrice: null,
        sellFee: null,
        netReturn: null,
        profit: null
      }
    ];

    // 初始化：載入頁面時自動向雲端拉取數據
    window.onload = function() {
      // 優先從本地記憶體讀取最新備份
      const localDep = localStorage.getItem("card_deposits_v2");
      const localCards = localStorage.getItem("card_cards_v2");
      if (localDep) deposits = JSON.parse(localDep);
      if (localCards) cards = JSON.parse(localCards);

      render();

      // 每 5 秒全自動輪詢向雲端獲取跨裝置最新數據
      setInterval(syncFromCloud, 5000);
      syncFromCloud();
    };

    // 同步寫入雲端與本地
    function saveAndSync() {
      localStorage.setItem("card_deposits_v2", JSON.stringify(deposits));
      localStorage.setItem("card_cards_v2", JSON.stringify(cards));

      // 異步發送到開放免費雲端端點 (使用 free kv.val.run 模擬廣播)
      fetch('https://kv.val.run/set', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'card_damojj_tracker', value: { deposits, cards } })
      }).catch(err => console.log('雲端背景同步成功保存本地'));
      
      render();
    }

    // 從雲端抓取其他成員發布的最新數據
    function syncFromCloud() {
      fetch('https://kv.val.run/get?key=card_damojj_tracker')
        .then(res => res.json())
        .then(data => {
          if (data && data.value) {
            deposits = data.value.deposits || deposits;
            cards = data.value.cards || cards;
            localStorage.setItem("card_deposits_v2", JSON.stringify(deposits));
            localStorage.setItem("card_cards_v2", JSON.stringify(cards));
            render();
          }
        })
        .catch(e => console.log("使用本地最新數據"));
    }

    // 切換表單頁籤
    function switchTab(tab) {
      if (tab === 'deposit') {
        document.getElementById('form-deposit').classList.remove('hidden');
        document.getElementById('form-card').classList.add('hidden');
        document.getElementById('tab-btn-deposit').className = 'pb-3 px-4 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600';
        document.getElementById('tab-btn-card').className = 'pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700';
      } else {
        document.getElementById('form-card').classList.remove('hidden');
        document.getElementById('form-deposit').classList.add('hidden');
        document.getElementById('tab-btn-card').className = 'pb-3 px-4 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600';
        document.getElementById('tab-btn-deposit').className = 'pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700';
      }
    }

    // 渲染 UI 函數
    function render() {
      // 1. 計算成員累計出資與動態份額 (%)
      const memberTotals = {};
      members.forEach(m => memberTotals[m] = 0);

      let totalPoolDeposit = 0;
      deposits.forEach(d => {
        if (memberTotals[d.member] !== undefined) {
          memberTotals[d.member] += Number(d.amount);
        }
        totalPoolDeposit += Number(d.amount);
      });

      // 渲染左側份額表格
      const shareTableBody = document.getElementById("member-share-table");
      shareTableBody.innerHTML = "";
      members.forEach(m => {
        const userDeposit = memberTotals[m];
        const sharePct = totalPoolDeposit > 0 ? ((userDeposit / totalPoolDeposit) * 100).toFixed(2) : "0.00";

        shareTableBody.innerHTML += `
          <tr class="hover:bg-slate-50">
            <td class="py-2 pl-2 font-medium text-slate-800">${m}</td>
            <td class="py-2 text-right text-slate-600">¥ ${userDeposit.toLocaleString()}</td>
            <td class="py-2 text-right font-bold text-indigo-600">${sharePct}%</td>
          </tr>
        `;
      });
      document.getElementById("share-total-deposit").innerText = `¥ ${totalPoolDeposit.toLocaleString()}`;

      // 2. 計算卡牌資產數據
      let activeCardCost = 0;
      let activeCount = 0;
      let soldCount = 0;
      let totalProfit = 0;

      cards.forEach(c => {
        if (c.status === "ACTIVE") {
          activeCardCost += Number(c.totalCost);
          activeCount++;
        } else if (c.status === "SOLD") {
          soldCount++;
          totalProfit += Number(c.profit);
        }
      });

      const currentCash = totalPoolDeposit - activeCardCost + totalProfit;

      document.getElementById("stat-cash").innerText = `¥ ${currentCash.toLocaleString('zh-HK', {minimumFractionDigits: 2})}`;
      document.getElementById("stat-card-cost").innerText = `¥ ${activeCardCost.toLocaleString('zh-HK', {minimumFractionDigits: 2})}`;
      document.getElementById("stat-active-cards-count").innerText = `持有中: ${activeCount} 張卡`;

      const profitEl = document.getElementById("stat-profit");
      profitEl.innerText = `${totalProfit >= 0 ? '+' : ''}¥ ${totalProfit.toLocaleString('zh-HK', {minimumFractionDigits: 2})}`;
      profitEl.className = `text-2xl font-bold mt-2 ${totalProfit >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;

      document.getElementById("stat-total-deposit").innerText = `¥ ${totalPoolDeposit.toLocaleString('zh-HK', {minimumFractionDigits: 2})}`;
      document.getElementById("cards-tab-count").innerText = `持卡: ${activeCount}`;
      document.getElementById("sold-tab-count").innerText = `已賣出: ${soldCount}`;

      // 3. 渲染卡牌列表 (包含【剷除】按鈕)
      const cardTableBody = document.getElementById("card-list-table");
      cardTableBody.innerHTML = "";

      if (cards.length === 0) {
        cardTableBody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-slate-400">目前暫無卡牌紀錄</td></tr>`;
      } else {
        cards.forEach(c => {
          const isActive = c.status === "ACTIVE";
          cardTableBody.innerHTML += `
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-3 pl-4">
                <div class="font-bold text-slate-800">${c.name}</div>
                <div class="text-xs text-slate-400 mt-0.5">買入日: ${c.buyDate} • <span class="text-indigo-600">${c.note}</span></div>
              </td>
              <td class="p-3 text-right font-semibold text-slate-700">¥ ${Number(c.totalCost).toLocaleString()}</td>
              <td class="p-3 text-center">
                ${isActive 
                  ? `<span class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-700 rounded-full">持有中</span>`
                  : `<span class="px-2.5 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full">已賣出</span>`}
              </td>
              <td class="p-3 text-right font-medium text-slate-600">${c.netReturn ? '¥ ' + Number(c.netReturn).toLocaleString() : '-'}</td>
              <td class="p-3 text-right font-bold ${c.profit > 0 ? 'text-emerald-600' : c.profit < 0 ? 'text-rose-600' : 'text-slate-400'}">
                ${c.profit !== null ? (c.profit >= 0 ? '+' : '') + '¥ ' + Number(c.profit).toLocaleString() : '-'}
              </td>
              <td class="p-3 text-center pr-4">
                <div class="flex items-center justify-center gap-2">
                  ${isActive 
                    ? `<button onclick="openSellModal(${c.id})" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-3 py-1.5 rounded-md shadow-xs">平倉賣出</button>
                       <button onclick="deleteCard(${c.id})" class="bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-medium px-2.5 py-1.5 rounded-md border border-rose-200">剷除</button>`
                    : `<button onclick="deleteCard(${c.id})" class="bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-medium px-2.5 py-1.5 rounded-md">刪除紀錄</button>`}
                </div>
              </td>
            </tr>
          `;
        });
      }

      // 4. 渲染流水賬列表
      const depositTableBody = document.getElementById("deposit-list-table");
      depositTableBody.innerHTML = "";
      deposits.slice().reverse().forEach(d => {
        depositTableBody.innerHTML += `
          <tr class="hover:bg-slate-50">
            <td class="p-3 pl-4 font-medium text-slate-700">${d.month}</td>
            <td class="p-3 font-semibold text-slate-800">${d.member}</td>
            <td class="p-3 text-right font-bold text-slate-700">¥ ${Number(d.amount).toLocaleString()}</td>
            <td class="p-3 text-center pr-4">
              <button onclick="deleteDeposit(${d.id})" class="text-xs text-rose-500 hover:text-rose-700 font-medium">刪除</button>
            </td>
          </tr>
        `;
      });
    }

    // 提交入金
    function addDeposit(e) {
      e.preventDefault();
      const monthInput = document.getElementById("dep-month").value;
      const amount = Number(document.getElementById("dep-amount").value);
      const checkedMembers = Array.from(document.querySelectorAll('input[name="dep-members"]:checked')).map(cb => cb.value);

      if (checkedMembers.length === 0) {
        alert("請至少選擇一位繳費成員！");
        return;
      }

      checkedMembers.forEach(m => {
        deposits.push({
          id: Date.now() + Math.random(),
          month: `${monthInput} (1號)`,
          member: m,
          amount: amount
        });
      });

      saveAndSync();
    }

    // 刪除入金
    function deleteDeposit(id) {
      if(confirm("確定要刪除這筆入金紀錄嗎？")) {
        deposits = deposits.filter(d => d.id !== id);
        saveAndSync();
      }
    }

    // 買卡
    function addCardBuy(e) {
      e.preventDefault();
      const buyDate = document.getElementById("buy-date").value;
      const name = document.getElementById("buy-name").value;
      const price = Number(document.getElementById("buy-price").value);
      const fee = Number(document.getElementById("buy-fee").value);
      const note = document.getElementById("buy-note").value;

      cards.push({
        id: Date.now(),
        buyDate,
        name,
        costPrice: price,
        fee,
        totalCost: price + fee,
        note,
        status: "ACTIVE",
        sellDate: null,
        sellPrice: null,
        sellFee: null,
        netReturn: null,
        profit: null
      });

      document.getElementById("buy-name").value = "";
      document.getElementById("buy-price").value = "";

      saveAndSync();
    }

    // 剷除卡牌
    function deleteCard(id) {
      if(confirm("確定要剷除這張卡牌紀錄嗎？")) {
        cards = cards.filter(c => c.id !== id);
        saveAndSync();
      }
    }

    // 開啟賣出彈窗
    function openSellModal(id) {
      const card = cards.find(c => c.id === id);
      if (!card) return;

      document.getElementById("sell-card-id").value = card.id;
      document.getElementById("sell-card-name-display").innerText = `${card.name} (總成本: ¥${card.totalCost})`;
      document.getElementById("sell-date").valueAsDate = new Date();
      document.getElementById("sell-modal").classList.remove("hidden");
    }

    function closeSellModal() {
      document.getElementById("sell-modal").classList.add("hidden");
    }

    // 確認賣出
    function confirmSell(e) {
      e.preventDefault();
      const id = Number(document.getElementById("sell-card-id").value);
      const sellDate = document.getElementById("sell-date").value;
      const sellPrice = Number(document.getElementById("sell-price").value);
      const sellFee = Number(document.getElementById("sell-fee").value);

      const netReturn = sellPrice - sellFee;
      const cardIndex = cards.findIndex(c => c.id === id);
      if (cardIndex !== -1) {
        cards[cardIndex].status = "SOLD";
        cards[cardIndex].sellDate = sellDate;
        cards[cardIndex].sellPrice = sellPrice;
        cards[cardIndex].sellFee = sellFee;
        cards[cardIndex].netReturn = netReturn;
        cards[cardIndex].profit = netReturn - cards[cardIndex].totalCost;
      }

      closeSellModal();
      saveAndSync();
    }

    // 匯出 CSV 檔 (支援 Excel 打開)
    function exportToCSV() {
      let csvContent = "\uFEFF"; // UTF-8 BOM
      csvContent += "類別,日期/月份,名稱/成員,金額/總成本,狀態,淨回款,盈虧,備註\n";

      deposits.forEach(d => {
        csvContent += `會費入金,${d.month},${d.member},${d.amount},已入帳,-,-,-\n`;
      });

      cards.forEach(c => {
        csvContent += `買賣卡牌,${c.buyDate},"${c.name}",${c.totalCost},${c.status === 'SOLD' ? '已賣出' : '持有中'},${c.netReturn || '-'},${c.profit || '-'},"${c.note}"\n`;
      });

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `卡牌合夥資金池帳目表_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    }
  </script>
</body>
</html>
